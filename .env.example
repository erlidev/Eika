# Optional settings for compose.yaml. Nothing here is required: the stack
# starts without a .env, and everything a user chooses (the sign-in password,
# model providers and API keys, models, the sandbox image, subagent limits,
# git credentials) is set in the web UI. Copy this file to .env only to change
# one of the values below. Never commit .env.

# Host port the Eika UI and API are published on, on 127.0.0.1. Default 8080.
EIKA_PORT=8080

# A fixed API token for scripts and automation, sent as
# `Authorization: Bearer <token>`. The UI does not need it. Leave it empty to
# allow only password sign-in. Generate one with: openssl rand -hex 32
EIKA_AUTH_TOKEN=

# PostgreSQL password. Postgres is not published outside the compose network,
# so the default is safe; set this only to use your own. It takes effect when
# the database volume is first created.
POSTGRES_PASSWORD=

# SearXNG session secret. The instance serves the harness alone on the
# internal network; set this only to replace the built-in value.
SEARXNG_SECRET=

# Loopback ports `make dev` publishes postgres and SearXNG on, through
# compose.dev.yaml. Only development uses them.
POSTGRES_PORT=5432
SEARXNG_PORT=8888
