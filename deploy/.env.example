# Copy to deploy/.env and fill in. Never commit deploy/.env.
# docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# Every published port binds to 127.0.0.1. Eika is single-user and the sandbox
# containers it starts are root-equivalent on the host, so nothing is exposed
# on a public interface. Put it behind a reverse proxy if you need remote
# access.

# Bearer token required by every Eika API route except /healthz. Required.
# Generate one with: openssl rand -hex 32
EIKA_AUTH_TOKEN=

# Host port the Eika UI and API are published on, on 127.0.0.1. Default 8080.
EIKA_PORT=8080

# Image used for workspaces that do not override it. Build it with `make sandbox`.
EIKA_SANDBOX_IMAGE=eika-sandbox:latest

# Group id of the host's /var/run/docker.sock, baked into the harness image at
# build time so the harness can run as a non-root user and still reach the
# socket. Find it with: stat -c %g /var/run/docker.sock
# Accepted risk: access to the Docker socket is equivalent to root on the host.
# The harness needs it because sandboxes are sibling containers.
DOCKER_GID=999

# API key for the models declared in deploy/eika.yaml. The key name must match
# the model's api_key_env. Add one variable per provider you configure.
OPENAI_API_KEY=

# Optional credentials for private HTTPS git remotes. In the project request,
# set remote_username_env to EIKA_GIT_USERNAME and remote_password_env to
# EIKA_GIT_PASSWORD. An upgraded legacy project with URL credential data also
# receives these references. Set both values before its next fetch or push.
# Add explicit compose mappings for more credential pairs.
EIKA_GIT_USERNAME=
EIKA_GIT_PASSWORD=

# PostgreSQL credentials and the host port it is published on, on 127.0.0.1.
# POSTGRES_PASSWORD is required; generate one with: openssl rand -hex 16
POSTGRES_USER=eika
POSTGRES_PASSWORD=
POSTGRES_DB=eika
POSTGRES_PORT=5432

# SearXNG session secret. Required. Generate one with: openssl rand -hex 32
SEARXNG_SECRET=

# Host port SearXNG is published on, on 127.0.0.1. Only needed for debugging
# searches; the harness reaches SearXNG over the internal network.
SEARXNG_PORT=8888
