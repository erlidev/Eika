    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.45.0",
    "monaco-editor": "0.56.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
